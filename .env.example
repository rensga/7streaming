# Copia este archivo como .env; define ambos valores antes de habilitar el panel.
ADMIN_EMAIL=
ADMIN_PASSWORD=
PORT=2008
APP_ORIGIN=http://localhost:2008
# En producción establece APP_ORIGIN en tu dominio HTTPS y configura el proxy TLS.
# Opcional: URL base del CDN para assets compilados; defínela en build y en el servidor.
ASSET_CDN_URL=
# Credenciales de Firebase Admin para Firestore en Vercel; privada, nunca uses el prefijo VITE_.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Usuario público de Telegram (sin @). Es una variable pública incluida en el JavaScript compilado, no un secreto.
VITE_TELEGRAM_USERNAME=rensgaaa