{
  "name": "7streaming",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "prestart": "npm run build",
    "dev": "concurrently --kill-others --names api,web \"npm:server:dev\" \"vite --config vite.config.js\"",
    "server:dev": "cross-env APP_ORIGIN=http://127.0.0.1:5173 node --watch --env-file-if-exists=.env server.js",
    "build": "node build-and-restart.js",
    "pretest": "npm run build",
    "test": "node --test"
  },
  "dependencies": {
    "firebase-admin": "^14.5.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "vite": "^7.1.7"
  },
  "engines": {
    "node": ">=22"
  }
}
